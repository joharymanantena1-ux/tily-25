---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LohaPejy from '../components/LohaPejy.astro';
import { sary } from '../data/sary';
import { tahiry, sampanaSafidy } from '../data/tahiry';

const href = '/tahirin-tsary/';

const taonaTsyFantatra = 'Tsy fantatra';
const singa = await Promise.all(
  tahiry.map(async (t) => {
    const s = sary[t.sary];
    // Tsy misy fanapahana: ny sary dia tazonina amin'ny refiny voajanahary.
    const kely = await getImage({ src: s.src, width: 720, quality: 72 });
    const lehibe = await getImage({ src: s.src, width: 1400, quality: 72 });
    return { ...t, s, kely, lehibe, taonaSoratra: t.taona ? String(t.taona) : taonaTsyFantatra };
  }),
);

const taonaRehetra = [...new Set(singa.map((s) => s.taonaSoratra))].sort().reverse();
const hetsikaRehetra = [...new Set(singa.map((s) => s.hetsika))].sort();
const misyOhatra = singa.some((s) => s.ohatra);
---

<Base href={href} lohateny="Tahirin-tsary">
  <LohaPejy
    href={href}
    lede={misyOhatra
      ? 'Sary ohatra ireto, fa tsy sarin’ny Fivondronana; hosoloina rehefa azo.'
      : 'Tsindrio ny sary iray raha hijery azy feno efijery.'}
  />

  <section class="atiny fizarana-tahiry">
    <form class="sivana" aria-label="Sivana ny sary" onsubmit="return false">
      <label>
        <span>Taona</span>
        <select data-sivana="taona">
          <option value="">Rehetra</option>
          {taonaRehetra.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
      <label>
        <span>Sampana</span>
        <select data-sivana="sampana">
          <option value="">Rehetra</option>
          {sampanaSafidy.map((s) => <option value={s}>{s}</option>)}
        </select>
      </label>
      <label>
        <span>Hetsika</span>
        <select data-sivana="hetsika">
          <option value="">Rehetra</option>
          {hetsikaRehetra.map((h) => <option value={h}>{h}</option>)}
        </select>
      </label>
      <p class="isa" data-isa aria-live="polite">Sary {singa.length}</p>
    </form>

    <ul class="rakitra" data-tahiry>
      {
        singa.map((x, i) => (
          <li data-singa data-taona={x.taonaSoratra} data-sampana={x.sampana} data-hetsika={x.hetsika}>
            <button
              type="button"
              data-sokafy
              data-lehibe={x.lehibe.src}
              data-alt={x.s.alt}
              data-lohateny={x.s.lohateny}
              data-antsipiriany={`${x.hetsika} · ${x.sampana} · Taona: ${x.taonaSoratra}`}
              aria-label={`Hijery feno efijery: ${x.s.lohateny}`}
            >
              <img
                src={x.kely.src}
                width={x.kely.attributes.width}
                height={x.kely.attributes.height}
                alt={x.s.alt}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </button>
            <p class="lohateny-sary">{x.s.lohateny}</p>
            <!-- Ny tompon'ny sary dia aseho ao amin'ny fijerena feno efijery sy ao amin'ny pejy Loharano -->
            <p class="mpaka" hidden>
              Sary: {x.s.mpaka} · <a href={x.s.lisansaUrl} rel="license noopener">{x.s.lisansa}</a> ·
              <a href={x.s.loharano} rel="noopener">Wikimedia Commons</a>
            </p>
          </li>
        ))
      }
    </ul>

    <div class="tsisy" data-tsisy hidden>
      <p>Mbola tsy misy sary mifanaraka amin’io safidy io.</p>
      <button class="rohy-bokotra" type="button" data-avereno>Hijery ny sary rehetra</button>
    </div>
  </section>

  <!-- Fijerena feno efijery -->
  <dialog class="jery" id="jery" aria-label="Sary feno efijery">
    <div class="jery-loha">
      <p data-jery-laharana aria-live="polite"></p>
      <button type="button" class="jery-bokotra" data-jery-hidio>Hidio ✕</button>
    </div>
    <div class="jery-sehatra">
      <img data-jery-sary src="" alt="" />
    </div>
    <div class="jery-tongotra">
      <button type="button" class="jery-zana" data-jery-aloha aria-label="Sary teo aloha">←</button>
      <div class="jery-soratra">
        <p class="jery-lohateny" data-jery-lohateny></p>
        <p data-jery-antsipiriany></p>
        <p class="jery-mpaka" data-jery-mpaka></p>
      </div>
      <button type="button" class="jery-zana" data-jery-manaraka aria-label="Sary manaraka">→</button>
    </div>
  </dialog>
</Base>

<style>
  .fizarana-tahiry {
    padding-block: 1rem 1rem;
  }

  /* ——— Sivana ——— */
  .sivana {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--tsipika);
  }

  /* finday: andalana iray isaky ny sivana — anarana ankavia, safidy ankavanana */
  .sivana label {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: center;
    border-bottom: 1px solid var(--tsipika);
  }

  .sivana label span {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .sivana select {
    width: 100%;
    min-height: 48px;
    padding: 0.4rem 0;
    font: inherit;
    color: var(--ranomainty);
    background: transparent;
    border: 0;
  }

  .isa {
    padding-top: 0.6rem;
    font-size: 0.84rem;
    color: var(--ranomainty-2);
  }

  @media (min-width: 700px) {
    .sivana {
      grid-template-columns: repeat(3, minmax(0, 200px)) 1fr;
      column-gap: 1.6rem;
      align-items: center;
      border-bottom: 1px solid var(--tsipika);
    }

    .sivana label {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.7rem;
      border-bottom: 0;
    }

    .isa {
      padding-top: 0;
      text-align: right;
    }
  }

  /* ——— Sary: tsanganana, refy voajanahary, tsy misy tapahina ——— */
  .rakitra {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    columns: 2;
    column-gap: 0.9rem;
  }

  @media (min-width: 700px) {
    .rakitra {
      columns: 3;
      column-gap: 1.4rem;
    }
  }

  .rakitra li {
    break-inside: avoid;
    margin-bottom: 1.2rem;
  }

  .rakitra li[hidden] {
    display: none;
  }

  .rakitra button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .rakitra img {
    width: 100%;
    height: auto;
  }

  .lohateny-sary {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--ranomainty-2);
  }

  .tsisy {
    margin-top: 1.5rem;
    color: var(--ranomainty-2);
  }

  .tsisy[hidden] {
    display: none;
  }

  .rohy-bokotra {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--manga);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  /* ——— Feno efijery: ny sary manontolo, tsy mihoatra ny efijery ——— */
  .jery {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: #0d1226;
    color: #fff;
  }

  .jery[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .jery::backdrop {
    background: #0d1226;
  }

  .jery-loha {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.3rem 1rem;
    font-size: 0.9rem;
  }

  .jery-bokotra,
  .jery-zana {
    min-width: 48px;
    min-height: 48px;
    padding: 0.4rem 0.6rem;
    border: 0;
    background: none;
    color: #fff;
    font: 600 1rem var(--soratra);
    cursor: pointer;
  }

  .jery-zana {
    font-size: 1.5rem;
  }

  .jery-sehatra {
    min-height: 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
  }

  .jery-sehatra img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .jery-tongotra {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.5rem 0.9rem;
  }

  .jery-soratra {
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.75);
  }

  .jery-lohateny {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
  }

  .jery-mpaka {
    font-size: 0.7rem;
  }

  .jery-mpaka :global(a) {
    color: inherit;
  }

  .jery :focus-visible {
    outline-color: var(--vony);
  }

  @media (prefers-reduced-motion: no-preference) {
    .jery[open] {
      animation: sokafy-jery 0.25s ease-out;
    }

    .jery-sehatra :global(img.avy-ankavanana) {
      animation: avy-ankavanana 0.3s ease-out;
    }

    .jery-sehatra :global(img.avy-ankavia) {
      animation: avy-ankavia 0.3s ease-out;
    }

    @keyframes sokafy-jery {
      from {
        opacity: 0;
      }
    }

    @keyframes avy-ankavanana {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
    }

    @keyframes avy-ankavia {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
    }
  }
</style>
